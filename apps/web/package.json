{
  "name": "@aipass/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svedocs dev",
    "build": "node scripts/generate-og-images.mjs && svedocs build --mode static --no-og",
    "og": "node scripts/generate-og-images.mjs",
    "preview": "svedocs preview",
    "check": "svedocs check && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "svedocs check",
    "test": "node --test scripts/*.test.mjs",
    "cloudflare:whoami": "wrangler whoami",
    "worker:types": "wrangler types src/worker-configuration.d.ts",
    "worker:types:check": "wrangler types src/worker-configuration.d.ts --check",
    "deploy:check": "pnpm check && pnpm worker:types:check && pnpm build && wrangler deploy --dry-run",
    "deploy": "pnpm check && pnpm worker:types:check && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.1.0",
    "@fortawesome/free-brands-svg-icons": "7.1.0",
    "@fortawesome/svelte-fontawesome": "0.2.4",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.60.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.0",
    "lucide-svelte": "1.0.1",
    "svedocs": "0.1.1-beta.2",
    "svelte": "5.55.7",
    "tailwindcss": "4.3.0",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "svedocs-cli": "0.1.1-beta.2",
    "svelte-check": "4.7.2",
    "typescript": "6.0.3",
    "wrangler": "4.114.0"
  }
}
