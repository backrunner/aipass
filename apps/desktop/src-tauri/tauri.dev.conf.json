{
  "productName": "AIPass Dev",
  "identifier": "com.alkinum.aipass.dev",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIPass",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "devtools": true
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. --filter @aipass/extension... build && pnpm dev:agent && pnpm build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aipass-dev"]
      }
    }
  },
  "bundle": {
    "resources": {
      "../../../target/release/aipass-agent*": null,
      "../../../target/release/aipass-native-host*": null,
      "../../../target/debug/aipass-agent*": "",
      "../../../target/debug/aipass-native-host*": ""
    }
  }
}
