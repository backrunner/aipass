{
  "name": "aipass",
  "version": "0.2.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "turbo build",
    "extension:edge:validate": "pnpm --filter @aipass/extension edge:validate",
    "dev": "turbo dev",
    "lint": "node scripts/repo-health.mjs && turbo lint",
    "repo:check": "node scripts/repo-health.mjs",
    "licenses:audit": "node scripts/license-audit.mjs",
    "native-host:install": "node scripts/install-native-host.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "test": "node --test scripts/repo-health.test.mjs scripts/cloudkit-profile.test.mjs scripts/deploy-cloudkit-schema.test.mjs scripts/verify-macos-runtime.test.mjs && turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
